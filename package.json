{
  "name": "criclife",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "CricLife \u2014 futuristic, mobile-first, real-time cricket scoring and statistics PWA",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"*.{json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "size": "size-limit",
    "icons": "python3 scripts/generate-icons.py",
    "deploy": "vite build && wrangler deploy",
    "prepare": "husky"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.58.0",
    "@tanstack/react-query": "^5.90.2",
    "@tanstack/react-virtual": "^3.13.12",
    "clsx": "^2.1.1",
    "dexie": "^4.2.0",
    "dexie-react-hooks": "^1.1.7",
    "lucide-react": "^0.544.0",
    "motion": "^12.23.22",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.64.0",
    "react-router": "^7.9.3",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.11",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.55.1",
    "@size-limit/preset-app": "^11.2.0",
    "@tailwindcss/vite": "^4.1.13",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.18.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.3",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^6.1.0",
    "eslint-plugin-react-refresh": "^0.4.23",
    "fake-indexeddb": "^6.2.5",
    "fast-check": "^4.3.0",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "jsdom": "^27.0.0",
    "lint-staged": "^16.2.1",
    "prettier": "^3.6.2",
    "size-limit": "^11.2.0",
    "supabase": "^2.111.0",
    "tailwindcss": "^4.1.13",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.45.0",
    "vite": "^7.1.7",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "^3.2.4",
    "workbox-window": "^7.3.0",
    "wrangler": "^4.118.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.{css,json,md}": [
      "prettier --write"
    ]
  },
  "size-limit": [
    {
      "name": "audience route (initial JS)",
      "path": [
        "dist/assets/*.js",
        "!dist/assets/ScorerRoute-*.js",
        "!dist/assets/AdminRoute-*.js",
        "!dist/assets/RanksRoute-*.js",
        "!dist/assets/AppearanceSettings-*.js",
        "!dist/assets/OfflinePage-*.js",
        "!dist/assets/AuthedOutlet-*.js",
        "!dist/assets/PublicAuthedOutlet-*.js",
        "!dist/assets/AuthProvider-*.js",
        "!dist/assets/LoginPage-*.js",
        "!dist/assets/AuthCallbackPage-*.js",
        "!dist/assets/OnboardingPage-*.js",
        "!dist/assets/ClaimPlayerPage-*.js",
        "!dist/assets/TeamsPage-*.js",
        "!dist/assets/NewTeamPage-*.js",
        "!dist/assets/TeamSquadPage-*.js",
        "!dist/assets/AddPlayerPage-*.js",
        "!dist/assets/TeamSettingsPage-*.js",
        "!dist/assets/PlayerProfilePage-*.js",
        "!dist/assets/PlayerEditPage-*.js",
        "!dist/assets/Crest-*.js",
        "!dist/assets/Avatar-*.js",
        "!dist/assets/roleLabels-*.js",
        "!dist/assets/hooks-*.js",
        "!dist/assets/plus-*.js",
        "!dist/assets/supabase-*.js",
        "!dist/assets/RedeemGrantPage-*.js",
        "!dist/assets/MatchHubPage-*.js",
        "!dist/assets/NewMatchPage-*.js",
        "!dist/assets/MatchSetupPage-*.js",
        "!dist/assets/ScoringRightsMapPage-*.js",
        "!dist/assets/db-*.js",
        "!dist/assets/ChartsTab-*.js",
        "!dist/assets/ScorecardTab-*.js",
        "!dist/assets/SquadsTab-*.js",
        "!dist/assets/TvLayout-*.js",
        "!dist/assets/VirtualFeed-*.js"
      ],
      "limit": "180 kB"
    }
  ]
}
